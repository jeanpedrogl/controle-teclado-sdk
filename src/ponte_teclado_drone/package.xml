<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ponte_teclado_drone</name>
  <version>0.1.0</version>
  <description>
    Pilota o drone DJI Mini SE pelo teclado e mouse do computador; ponte ROS2
    para o app Android (celular), que repassa os comandos ao DJI SDK.
  </description>
  <maintainer email="jeanpedrogrossi@gmail.com">Jean Pedro Grossi Líbero</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rosbridge_suite</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
